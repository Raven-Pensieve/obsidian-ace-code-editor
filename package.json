{
	"name": "ace-code-editor",
	"version": "2.1.3",
	"description": "An enhanced code editor using Ace editor, providing syntax highlighting, code folding, and other advanced editing features.",
	"main": "main.js",
	"scripts": {
		"dev": "node --env-file-if-exists=.env scripts/deploy.mjs link && node scripts/esbuild.config.mjs dev",
		"build": "tsc -noEmit -skipLibCheck && node scripts/esbuild.config.mjs prod && node --env-file-if-exists=.env scripts/deploy.mjs copy",
		"lint": "eslint src/ styles/",
		"i18n:typesafe": "typesafe-i18n",
		"i18n:sync": "node scripts/sync-i18n.mjs",
		"tmTheme": "node scripts/convert-themes.mjs"
	},
	"keywords": [
		"Ace Editor",
		"Code Editor",
		"Obsidian Plugin"
	],
	"author": "RavenHogWarts",
	"license": "GPL-3.0-only",
	"engines": {
		"node": ">=22.x"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/ace": "^0.0.52",
		"@types/node": "^25.9.0",
		"@types/plist": "^3.0.5",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"esbuild": "0.28.1",
		"eslint": "^10.4.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"lucide-react": "^1.17.0",
		"obsidian": "^1.13.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"plist": "^5.0.0",
		"tslib": "2.8.1",
		"typesafe-i18n": "^5.27.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.59.4"
	},
	"dependencies": {
		"ace-builds": "^1.44.0",
		"html-react-parser": "^6.1.1",
		"radix-ui": "^1.4.3",
		"react-ace": "^14.0.1"
	}
}
